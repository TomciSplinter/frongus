# Copy these into Vercel → Project → Settings → Environment Variables.

# Required: a mainnet RPC URL (Helius, QuickNode, Triton...). The public RPC blocks sending transactions.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Required: any long random string.
SIGNING_SECRET=replace-with-a-long-random-string

# Recommended: your site's public URL.
SITE_URL=https://your-domain

# Optional
PINATA_JWT=
PRIORITY_FEE_MICROLAMPORTS=150000
MAX_DEV_BUY=50000000
FRONGUS_MINT=2BJDwUdMbnJhRRfhacFDjrDNhxUWdzE9H6LEND89pump
PUMP_LOOKUP_TABLE=Hyif6eWb8x88RVrvjPfabsgRYnwkVnyByEXTVTXbUcyP
